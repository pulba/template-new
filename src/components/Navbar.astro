---
import ThemeToggle from "./ThemeToggle";
import { getEntry } from "astro:content";

const identity = await getEntry("settings", "identity");
const siteConfig = identity?.data || { schoolName: "Nama Sekolah" };

const navItems = [
  { name: "Beranda", href: "/" },
  { name: "Profil", href: "/profil" },
  { name: "Akademik", href: "/akademik" },
  { name: "Berita", href: "/berita" },
  { name: "Galeri", href: "/galeri" },
  { name: "Kontak", href: "/kontak" },
];

const pathname = Astro.url.pathname;
const normalizedPathname = pathname.endsWith('/') ? pathname : `${pathname}/`;
---

<nav
  class="sticky top-0 z-50 bg-white/80 dark:bg-stone-950/80 backdrop-blur-md border-b border-stone-200 dark:border-stone-800 transition-colors duration-300"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-20">
      <div class="flex items-center">
        <a href="/" class="flex-shrink-0 flex items-center gap-2 sm:gap-3 group">
          <div
            class="w-10 h-10 sm:w-12 sm:h-12 bg-white dark:bg-stone-100 rounded-lg sm:rounded-xl overflow-hidden flex items-center justify-center text-stone-900 font-bold text-xl sm:text-2xl uppercase shadow-sm group-hover:shadow-md transition-all border border-stone-100 dark:border-stone-800"
          >
            {
              siteConfig.logoUrl && siteConfig.logoUrl !== "/favicon.svg" ? (
                <img
                  src={siteConfig.logoUrl}
                  alt={siteConfig.schoolName}
                  class="w-full h-full object-contain p-1"
                />
              ) : (
                <span>{siteConfig.schoolName.charAt(0)}</span>
              )
            }
          </div>
          <span
            class="font-bold text-lg sm:text-xl tracking-tight text-stone-900 dark:text-stone-100 uppercase line-clamp-1"
            >{siteConfig.schoolName}</span
          >
        </a>
      </div>
      <div class="hidden lg:flex items-center space-x-6">
        {
          navItems.map((item) => {
            const itemPath = item.href.endsWith('/') ? item.href : `${item.href}/`;
            const isActive = normalizedPathname === itemPath;
            return (
              <a
                href={item.href}
                class={`transition-colors duration-200 ${
                  isActive 
                    ? "text-stone-900 dark:text-stone-100 font-bold" 
                    : "text-stone-600 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-100 font-medium"
                }`}
              >
                {item.name}
              </a>
            );
          })
        }

        <div
          class="flex items-center gap-4 border-l border-stone-200 dark:border-stone-800 pl-6"
        >
          <ThemeToggle client:load />
          <a
            href="/pendaftaran"
            class="bg-stone-900 dark:bg-stone-100 text-white dark:text-stone-900 px-6 py-2.5 rounded-full font-semibold hover:bg-stone-800 dark:hover:bg-stone-200 transition-all duration-200 shadow-sm"
          >
            Daftar
          </a>
        </div>
      </div>

      <div class="lg:hidden flex items-center gap-4">
        <ThemeToggle client:load />
        <button
          type="button"
          class="text-stone-600 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-100 p-2 transition-colors"
          id="mobile-menu-button"
          aria-label="Menu"
        >
          <svg
            class="h-6 w-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              id="menu-icon-path"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div class="lg:hidden hidden" id="mobile-menu">
    <div
      class="px-4 pt-2 pb-6 space-y-2 bg-white dark:bg-stone-950 border-b border-stone-200 dark:border-stone-800 shadow-xl"
    >
      {
        navItems.map((item) => {
          const itemPath = item.href.endsWith('/') ? item.href : `${item.href}/`;
          const isActive = normalizedPathname === itemPath;
          return (
            <a
              href={item.href}
              class={`block px-4 py-3 rounded-2xl text-base transition-all ${
                isActive 
                  ? "font-bold text-stone-900 dark:text-stone-100 bg-stone-100 dark:bg-stone-900" 
                  : "font-medium text-stone-600 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-100 hover:bg-stone-50 dark:hover:bg-stone-900"
              }`}
            >
              {item.name}
            </a>
          );
        })
      }
      <div class="pt-4 border-t border-stone-100 dark:border-stone-800">
        <a
          href="/pendaftaran"
          class="block w-full text-center bg-stone-900 dark:bg-stone-100 text-white dark:text-stone-900 py-4 rounded-2xl font-bold shadow-lg"
        >
          Daftar Sekarang
        </a>
      </div>
    </div>
  </div>
</nav>

<script>
  const button = document.getElementById("mobile-menu-button");
  const menu = document.getElementById("mobile-menu");

  button?.addEventListener("click", () => {
    menu?.classList.toggle("hidden");
  });
</script>
