---
import Layout from "../../layouts/Layout.astro";
import { isAuthenticated, logout } from "../../lib/auth";
import RegistrationTable from "../../components/RegistrationTable";
import { Settings, Users, LogOut, LayoutDashboard } from "lucide-react";

if (!isAuthenticated(Astro.cookies)) { return Astro.redirect("/dashboard/login"); }

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  if (formData.get("action") === "logout") {
    logout(Astro.cookies);
    return Astro.redirect("/dashboard/login");
  }
}
---

<Layout title="Admin Dashboard - Unified Portal">
  <div class="min-h-screen bg-stone-50 dark:bg-stone-950 flex flex-col md:flex-row">
    
    <!-- Sidebar -->
    <aside class="w-full md:w-64 bg-white dark:bg-stone-900 border-b md:border-b-0 md:border-r border-stone-200 dark:border-stone-800 flex flex-col">
      <div class="p-8 border-b border-stone-100 dark:border-stone-800">
        <h1 class="text-sm font-bold tracking-[0.2em] flex items-center gap-2">
          <LayoutDashboard size={18} /> ADMIN PANEL
        </h1>
      </div>
      
      <nav class="flex-1 p-4 space-y-2">
        <button id="btn-content" class="w-full flex items-center gap-3 px-4 py-3 text-sm font-bold rounded-lg bg-stone-100 dark:bg-stone-800 text-stone-900 dark:text-white transition-all">
          <Settings size={18} className="text-stone-400" /> Kelola Konten
        </button>
        <button id="btn-registrations" class="w-full flex items-center gap-3 px-4 py-3 text-sm font-bold rounded-lg text-stone-500 hover:bg-stone-50 dark:hover:bg-stone-800 transition-all">
          <Users size={18} className="text-stone-400" /> Data Pendaftar
        </button>
      </nav>

      <div class="p-4 border-t border-stone-100 dark:border-stone-800">
        <form method="POST">
          <input type="hidden" name="action" value="logout" />
          <button class="w-full flex items-center gap-3 px-4 py-3 text-sm font-bold text-red-500 hover:bg-red-50 dark:hover:bg-red-900/20 rounded-lg transition-all">
            <LogOut size={18} /> Keluar
          </button>
        </form>
      </div>
    </aside>

    <!-- Main Content Area -->
    <main class="flex-1 flex flex-col overflow-hidden">
      <!-- Tab 1: Decap CMS -->
      <section id="panel-content" class="flex-1">
        <iframe src="/admin/" class="w-full h-full border-none" title="Decap CMS Content Manager"></iframe>
      </section>

      <!-- Tab 2: Registrations -->
      <section id="panel-registrations" class="hidden flex-1 p-8 overflow-y-auto">
        <div class="max-w-6xl mx-auto">
          <div class="mb-10">
            <h2 class="text-3xl font-bold text-stone-900 dark:text-stone-100 tracking-tight mb-2">Data Pendaftar Online</h2>
            <p class="text-stone-500">Pantau dan kelola seluruh formulir masuk dari database Turso.</p>
          </div>
          <RegistrationTable client:load />
        </div>
      </section>
    </main>
  </div>

  <script is:inline>
    const btnContent = document.getElementById('btn-content');
    const btnReg = document.getElementById('btn-registrations');
    const panelContent = document.getElementById('panel-content');
    const panelReg = document.getElementById('panel-registrations');

    function setActive(activeBtn, otherBtn, activePanel, otherPanel) {
      // Buttons
      activeBtn.classList.add('bg-stone-100', 'dark:bg-stone-800', 'text-stone-900', 'dark:text-white');
      activeBtn.classList.remove('text-stone-500');
      otherBtn.classList.remove('bg-stone-100', 'dark:bg-stone-800', 'text-stone-900', 'dark:text-white');
      otherBtn.classList.add('text-stone-500');

      // Panels
      activePanel.classList.remove('hidden');
      otherPanel.classList.add('hidden');
    }

    btnContent.addEventListener('click', () => setActive(btnContent, btnReg, panelContent, panelReg));
    btnReg.addEventListener('click', () => setActive(btnReg, btnContent, panelReg, panelContent));
  </script>
</Layout>
