---
import Layout from "../../layouts/Layout.astro";
import { login, isAuthenticated } from "../../lib/auth";

if (isAuthenticated(Astro.cookies)) { return Astro.redirect("/dashboard"); }

let error = "";
if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const password = formData.get("password")?.toString();
  if (password && login(Astro.cookies, password)) {
    return Astro.redirect("/dashboard");
  } else {
    error = "Password administrator salah.";
  }
}
---

<Layout title="Login Admin - Dashboard">
  <main class="min-h-screen bg-stone-50 dark:bg-stone-950 flex items-center justify-center p-4">
    <div class="w-full max-w-md">
      <div class="text-center mb-10">
        <h1 class="text-2xl font-bold text-stone-900 dark:text-stone-100 uppercase tracking-widest mb-2">Admin Portal</h1>
        <p class="text-stone-500 text-sm">Masuk untuk mengelola konten dan pendaftaran</p>
      </div>

      <div class="bg-white dark:bg-stone-900 p-8 rounded-xl border border-stone-200 dark:border-stone-800 shadow-xl">
        <form method="POST" class="space-y-6">
          <div class="space-y-2">
            <label class="text-[10px] font-bold text-stone-500 uppercase tracking-widest">Password Panel</label>
            <input 
              type="password" 
              name="password" 
              required 
              class="w-full px-4 py-3 bg-stone-50 dark:bg-stone-950 border border-stone-100 dark:border-stone-800 rounded-lg focus:ring-1 focus:ring-stone-900 dark:focus:ring-white outline-none transition-all dark:text-white"
              autofocus
            />
          </div>

          {error && <p class="text-red-500 text-xs font-bold text-center">{error}</p>}

          <button class="w-full bg-stone-900 dark:bg-stone-100 text-white dark:text-stone-900 py-4 rounded-lg font-bold text-sm uppercase tracking-widest hover:opacity-90 transition-all">
            Login
          </button>
        </form>
      </div>
    </div>
  </main>
</Layout>
